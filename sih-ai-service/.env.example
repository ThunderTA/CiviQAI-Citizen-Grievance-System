# ==========================================================================
# SIH26-S02 Grievance AI Service (FastAPI)  —  copy to .env
# ==========================================================================
# The service runs with NO configuration at all. Every value below is
# optional; without API keys it uses its deterministic rule engine and local
# embedding model, which is enough for a full offline demo.

PORT=8000
LOG_LEVEL=INFO

# Origins allowed to call this service directly (the Node portal calls it
# server-to-server and is not subject to CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM providers --------------------------------------------------------
# Both optional. With neither set, classification uses keyword rules only.
# GEMINI_API_KEY accepts several comma-separated keys and rotates between them
# on quota errors (behaviour inherited from customer-complaint-agent_new).
GROQ_API_KEY=
GEMINI_API_KEY=

# Hard ceiling on a single LLM round trip. Grievance submission is synchronous,
# so a hung provider must not hold the citizen's form open.
LLM_TIMEOUT_SECONDS=8

# Set to false to force the deterministic path (offline demos, reproducible tests).
LLM_ENABLED=true

# --- Duplicate detection --------------------------------------------------
# Cosine similarity at or above this is a duplicate (problem statement: 0.85).
DUPLICATE_THRESHOLD=0.85

# Relaxed bar used only when two reports are within DUPLICATE_NEARBY_RADIUS_METERS
# of each other. Co-location is independent evidence, so the text bar can drop.
# Measured with tools/eval_thresholds.py: true civic paraphrases score 0.68-0.90,
# different grievances at the same spot top out at 0.64.
DUPLICATE_THRESHOLD_NEARBY=0.68
DUPLICATE_NEARBY_RADIUS_METERS=100

# A candidate further away than this is never a duplicate, however similar the
# text. Set to 0 to disable the geo gate.
DUPLICATE_RADIUS_METERS=500

# Neighbours pulled from FAISS before the geo gate is applied.
DUPLICATE_TOP_K=5

# --- Embeddings & storage -------------------------------------------------
# Downloaded from HuggingFace on first run (~80MB) and cached thereafter.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the FAISS index and its metadata sidecar are persisted. Mount this as a
# volume in Docker, or the index is lost on every restart.
VECTOR_STORE_DIR=data/vector_store

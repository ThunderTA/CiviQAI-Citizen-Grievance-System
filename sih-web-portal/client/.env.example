# ==========================================================================
# SIH26-S02 Web Portal — React client (Vite)  —  copy to .env
# ==========================================================================
# Vite only exposes variables prefixed with VITE_ to browser code, so nothing
# secret belongs here. The admin list deliberately is NOT mirrored client-side:
# the API resolves the role when it issues the session token.

VITE_API_URL=http://localhost:3000/api

# Optional: lets the submission form warn about likely duplicates as the
# citizen types, by calling the AI service directly.
VITE_AI_SERVICE_URL=http://localhost:8000

# --- Public demo build ------------------------------------------------------
# true: the login pages show one-click guest accounts and hide sign-up. These
# are baked into the build, so set them in the host's build settings.
VITE_DEMO_MODE=false
VITE_DEMO_PASSWORD=

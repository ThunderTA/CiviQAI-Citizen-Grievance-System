# ==========================================================================
# SIH26-S02 Web Portal — Node/Express API  —  copy to .env
# ==========================================================================

PORT=3000
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local Docker/Compose default. For Atlas use:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/citizencare
MONGODB_URI=mongodb://localhost:27017/citizencare

# --- Grievance AI service (sih-ai-service) --------------------------------
# The Express API calls this before every write to MongoDB for department
# routing, priority scoring and semantic duplicate detection.
# Under docker compose this becomes http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000

# Deadline for an AI call. On timeout the complaint is still saved, with
# fallback metadata and aiTriage.serviceStatus recording why.
AI_SERVICE_TIMEOUT_MS=12000

# --- Authentication -------------------------------------------------------
# Signing key for session tokens. Must be at least 16 characters; the server
# refuses to start in production without a real one.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails granted the owner role. Resolved at request time and
# never stored on the user document, so removing an address takes effect at
# once and the role cannot be granted through the API.
ADMIN_EMAILS=admin@demo.in

# --- Aadhaar identity check -----------------------------------------------
# SIMULATED verification — validates the Verhoeff check digit and runs a mock
# OTP round trip. NOT UIDAI e-KYC; see services/aadhaar.js before relying on it.
# The number is never stored, hashed or logged.
# Set to false to let people register without the step (development, tests).
REQUIRE_AADHAAR=true

# --- Optional: photo analysis & notifications -----------------------------
# Used by the existing Groq vision pass that inspects complaint photos.
# Text triage does not need this — that runs in the Python service.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Password reset -------------------------------------------------------
# How long a reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=60

# Reset links are emailed via the credentials below. With email unconfigured
# and NODE_ENV not "production", the link is returned in the API response
# instead so the flow is usable locally. Set NODE_ENV=production to disable
# that (and every other dev-only convenience).
EMAIL_USER=
EMAIL_PASS=

# Email / SMS / WhatsApp notification channels (all optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Repeat-report escalation -----------------------------------------------
# "people:points" steps. 2:1 means two different people reporting the same
# problem raise its priority score by 1; 5:2 means five raise it by 2, and so
# on (capped at 5). A single report can never escalate.
ESCALATION_STEPS=2:1,5:2,10:3
